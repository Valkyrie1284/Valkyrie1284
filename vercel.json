{
  "redirects": [
    {
      "source": "/galley-admin",
      "destination": "/docs/galley/admin.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/docs/galley/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
